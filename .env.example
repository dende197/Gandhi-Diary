# Gemini AI (primary AI for circolari summaries and AI chat)
GEMINI_API_KEY_SINTESI=AIzaSy...
GEMINI_API_KEY_PLANNER=AIzaSy...
GEMINI_API_KEY=AIzaSy...

# Groq AI (fallback AI for circolari summaries and AI chat)
GROQ_API_KEY=gsk_...

# Supabase Configuration
SUPABASE_URL=https://...
SUPABASE_SERVICE_ROLE_KEY=ey...
SUPABASE_ANON_KEY=ey...

# App Config
DEBUG_MODE=false

# Google Calendar OAuth2 (per-user flow)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.vercel.app/api/google?action=callback

# Vercel Cron Protection (required — set the same value in Vercel environment variables)
CRON_SECRET=your_random_secret_here

# Argo Password Encryption Key — 64 hex characters (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be set (required) to enable Argo password encryption.
ARGO_ENCRYPTION_KEY=your_64_hex_char_key_here

# Existing Argo username/password access, including server-side reauthentication.
# Omit to keep the current behavior (true). Only lowercase true/false are valid;
# surrounding whitespace is trimmed, but empty/other values fail closed with 503.
# Set false manually only when the cutover is intended. No date changes this flag.
# This is NOT an SPID/CIE integration: both remain unavailable until the provider
# session handoff has been implemented and verified. Do not disable credentials
# expecting another login method to appear automatically.
ARGO_LEGACY_AUTH_ENABLED=true

# Optional server-side Argo refresh token storage and renewal. Off by default.
# Requires migration 202610080001_argo_token_connections.sql and ARGO_ENCRYPTION_KEY.
# Enable first in a test environment and log in again to populate a connection.
# Provider metadata supports refresh_token; issuance for this client is unverified.
# Does not enable SPID/CIE login or change the Google refresh token.
ARGO_TOKEN_REFRESH_ENABLED=false

# Sessions are random, per-device credentials stored as digests in app_sessions.

# OAuth State Signing Key — 64 hex characters (32 bytes).
# Used to sign Google OAuth state parameters preventing CSRF.
OAUTH_STATE_KEY=your_oauth_state_key_here

# Allowed CORS Origins (comma-separated).
# Example: https://g-connect.vercel.app,https://your-org.github.io
ALLOWED_ORIGINS=

# School Circolari URL (optional, falls back to default)
SCHOOL_CIRCOLARI_URL=https://www.liceogandhi.edu.it/categoria/storico-circolari/

# Class Schedule for Google Calendar sync (optional JSON).
# If not set, the default 5D SA schedule (Tue-Sat, 08:00-12:00) is used automatically.
# Override only if your class schedule differs from the default.
# Example (4D schedule):
# CLASS_SCHEDULE={"lunedi":[{"materia":"SCIENZE","inizio":"08:00","fine":"09:00"},{"materia":"INGLESE","inizio":"09:00","fine":"10:00"},{"materia":"FISICA","inizio":"10:00","fine":"11:00"},{"materia":"FILOSOFIA","inizio":"11:00","fine":"12:00"},{"materia":"ARTE","inizio":"12:00","fine":"13:00"}],"martedi":[{"materia":"MATEMATICA","inizio":"08:00","fine":"09:00"},{"materia":"SCIENZE","inizio":"09:00","fine":"11:00"},{"materia":"STORIA","inizio":"11:00","fine":"12:00"},{"materia":"FISICA","inizio":"12:00","fine":"13:00"}],"mercoledi":[{"materia":"ITALIANO","inizio":"08:00","fine":"09:00"},{"materia":"SCIENZE MOTORIE","inizio":"09:00","fine":"10:00"},{"materia":"FILOSOFIA","inizio":"10:00","fine":"11:00"},{"materia":"STORIA","inizio":"11:00","fine":"12:00"},{"materia":"FISICA","inizio":"12:00","fine":"13:00"}],"giovedi":[{"materia":"INGLESE","inizio":"08:00","fine":"10:00"},{"materia":"ARTE","inizio":"10:00","fine":"11:00"},{"materia":"ITALIANO","inizio":"11:00","fine":"13:00"}],"venerdi":[{"materia":"ITALIANO","inizio":"08:00","fine":"09:00"},{"materia":"SCIENZE","inizio":"09:00","fine":"11:00"},{"materia":"MATEMATICA","inizio":"11:00","fine":"13:00"}],"sabato":[{"materia":"RELIGIONE","inizio":"08:00","fine":"09:00"},{"materia":"SCIENZE MOTORIE","inizio":"09:00","fine":"10:00"},{"materia":"MATEMATICA","inizio":"10:00","fine":"11:00"},{"materia":"INFORMATICA","inizio":"11:00","fine":"13:00"}]}
CLASS_SCHEDULE=

# Public frontend URL for the OAuth callback redirect.
PWA_URL=https://dende197.github.io/Gandhi-Diary/
# Use a currently available Gemini model; comma-separated fallbacks are optional.
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=
# Used only when Argo gives no duration and no per-user schedule is available.
SCHOOL_DAILY_HOURS=4
# Actual annual curricular hours; leave blank to return null instead of a false percentage.
SCHOOL_ANNUAL_HOURS=

# Web Push (Android Chrome, iOS/iPadOS Home Screen, Firefox).
# Generate once with: npx web-push generate-vapid-keys
# Keep the private key on the backend only. Do not rotate keys without resubscribing devices.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A monitored HTTPS contact URL or mailto: address; never localhost.
VAPID_SUBJECT=https://dende197.github.io/Gandhi-Diary/
# Dedicated bearer secret for the Supabase notification scheduler (not an Argo or VAPID key).
PUSH_CRON_SECRET=
